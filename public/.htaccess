# ==============================================================================
# KMS ASTROLOGY - APACHE / CPANEL / HOSTINGER CONFIGURATION
# Enables React SPA Routing, PWA Offline Service Workers, and PHP API Passthrough
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve HTTP Authorization header for PHP API Authentication
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # 1. Do not rewrite direct calls to the PHP API
  RewriteRule ^api/ - [L]

  # 2. Allow existing static files & directories (images, icons, manifest, sw.js)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Handle /admin and all client-side routes via index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Protect sensitive database & environment configuration files
<FilesMatch "^(db\.local\.php|db\.env|\.env.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Correct MIME Types for PWA
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js .mjs
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# Cache-Control for HTML, Service Worker & Manifest (Instant Updates)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  <FilesMatch "(sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
